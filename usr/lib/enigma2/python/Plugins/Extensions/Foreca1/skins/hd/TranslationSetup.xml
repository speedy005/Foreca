<screen name="TranslationSetup" position="center,center" size="700,450" title="Translation Settings" flags="wfNoBorder" backgroundColor="#ff000000">
    <!-- BACKGROUND PLATE - Full screen -->
    <widget name="background_plate" position="0,0" size="700,450" backgroundColor="#ff9632" zPosition="0" cornerRadius="32" />
    
    <!-- SELECTION OVERLAY - Inside with margins -->
    <widget name="selection_overlay" position="20,30" size="660,370" backgroundColor="#40000000" zPosition="1" cornerRadius="24" />
    
    <!-- Config list -->
    <widget name="config" position="35,50" itemHeight="44" size="630,310" scrollbarMode="showOnDemand" zPosition="10" backgroundColor="#000000" transparent="1" />
    
    <!-- Buttons with visible colors -->
    <widget source="key_red" render="Label" position="20,415" size="200,30" font="Regular;24" halign="center" valign="center" backgroundColor="#ff0000" foregroundColor="#ffffff" transparent="0" zPosition="10" />
    <widget source="key_green" render="Label" position="240,415" size="200,30" font="Regular;24" halign="center" valign="center" backgroundColor="#00cc00" foregroundColor="#ffffff" transparent="0" zPosition="10" />
    <widget source="status" render="Label" position="460,415" size="220,30" font="Regular;20" halign="center" valign="center" foregroundColor="#ffffff" backgroundColor="#000000" transparent="1" zPosition="10" />
</screen>